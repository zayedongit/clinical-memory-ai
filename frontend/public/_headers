# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching

/*
  # This app renders patient data. Defence-in-depth headers so a mistake
  # elsewhere is less likely to become an exposure.
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # The microphone is the one powerful feature this app needs; everything else
  # is denied outright.
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable
