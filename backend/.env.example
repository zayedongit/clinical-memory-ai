# Backend environment (FastAPI). Copy to .env and fill in.
# NEVER commit the real .env — only this .example file is tracked.

# =====================================================================
# Required. The server refuses to start without these.
# =====================================================================
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET, server-side only. Bypasses Row-Level Security, so it is used for
# exactly one thing: resolving auth_uid -> users row during authentication.
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# AI providers. All optional — the app degrades rather than breaking.
# =====================================================================
# Structured extraction and note generation. Tried in order: every Gemini
# model first, then OpenAI as a genuinely different vendor (a fallback that
# shares an outage with its primary is not a fallback).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACKS=gemini-2.0-flash,gemini-2.5-flash-lite

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-transcribe

# Speech-to-text falls back at runtime: OpenAI, then Sarvam. Configure both
# and a bad minute at one provider does not lose the doctor's speech.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
# "unknown" = auto-detect, which is what Hindi-English code-mixed speech needs.
SARVAM_STT_LANGUAGE=unknown

AI_TEMPERATURE=0.2
# Optional price overrides for the cost estimate, e.g.
# {"gemini-2.5-flash": [0.30, 2.50]}  (USD per 1M input, output tokens)
AI_PRICES_JSON=

# =====================================================================
# External Clinical Synthesis API (decision support — NOT built by this
# project). The base URL is a shared secret and the upstream is
# unauthenticated, so it is called only server-side. Leave blank to disable
# decision support; the app runs without it.
# =====================================================================
SYNTHESIS_API_BASE=
SYNTHESIS_API_KEY=
SYNTHESIS_TIMEOUT_S=30

# =====================================================================
# Limits
# =====================================================================
MAX_AUDIO_BYTES=26214400          # 25 MB, the provider ceiling
MAX_TRANSCRIPT_CHARS=60000
STT_TIMEOUT_S=180

# =====================================================================
# App
# =====================================================================
# Comma-separated. Must be exact origins in production — no wildcard.
FRONTEND_ORIGIN=http://localhost:3000

# =====================================================================
# Observability
# =====================================================================
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
SENTRY_DSN=                        # optional; error tracking is off when blank
METRICS_ENABLED=true
# Bearer token required to read /metrics. Leave blank only when the endpoint
# is not internet-reachable; the server warns at startup in production.
METRICS_TOKEN=

# =====================================================================
# Rate limiting (per caller, 60s sliding window, per process)
# =====================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AI_PER_MIN=90           # STT / LLM / decision-support routes
RATE_LIMIT_MAX_KEYS=20000          # bounded, so the limiter is not a memory sink

# =====================================================================
# Spend control
# =====================================================================
# Estimated USD this instance may spend on AI per day before the expensive
# routes start refusing. 0 disables the cap. Documentation keeps working
# either way — only AI assistance is withheld.
AI_DAILY_BUDGET_USD=0

# =====================================================================
# Tests only. Points the database test suite at a scratch PostgreSQL; it
# creates and drops its own databases, so never point it at real data.
# =====================================================================
# CMA_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
