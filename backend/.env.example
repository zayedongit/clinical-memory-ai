# Backend environment (FastAPI). Copy to .env and fill in.
# NEVER commit the real .env — only this .example file is tracked.

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # SECRET — server-side only
SUPABASE_JWT_SECRET=            # used to verify Supabase-issued JWTs

# --- AI providers (Phase 1 — leave blank for now) ---
GEMINI_API_KEY=
SARVAM_API_KEY=

# Speech-to-text: OpenAI gpt-4o-transcribe (preferred — used when set; Sarvam is the fallback).
# Use a DEDICATED key for this project (don't reuse Clinical Synthesis's OpenAI account).
OPENAI_API_KEY=                 # SECRET — server-side only, never commit

# --- Clinical Synthesis Clinical Synthesis API (decision-support brain) ---
# Base URL is a SHARED SECRET (unauthenticated upstream on a shared budget) — never commit.
# Called only from this backend, never the browser. Leave blank to disable decision support.
SYNTHESIS_API_BASE=              # Clinical Synthesis Clinical Synthesis API base URL (ask the maintainer)
SYNTHESIS_API_KEY=               # optional; sent as X-API-Key once the gate exists

# --- App config ---
FRONTEND_ORIGIN=http://localhost:3000
